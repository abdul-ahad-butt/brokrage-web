# ─────────────────────────────────────────────
# FreightBridge — Environment Variables
# Copy this file to .env (API) and apps/web/.env.local (Web)
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# PostgreSQL connection string for Prisma
# Used in: apps/api
DATABASE_URL="postgresql://freightbridge:freightbridge_dev@localhost:5432/freightbridge"

# ── API Server ────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Authentication ────────────────────────────
# JWT signing secret — MUST be changed before any production deployment
# Minimum 64 characters recommended for HS256
JWT_SECRET="replace_me_with_a_long_random_string_at_least_64_chars"

# JWT expiry (e.g. "7d", "24h", "15m")
JWT_EXPIRES_IN="7d"

# ── Partner Broker Information ────────────────
# These are filled in once a licensed broker partnership is signed.
# They appear in the legally-required footer on every page of the platform.
# FMCSA requires disclosure of the licensed broker's name and MC#.
#
# Used in: apps/web (NEXT_PUBLIC_ prefix = exposed to the browser)
NEXT_PUBLIC_BROKER_NAME="Partner Broker LLC"
NEXT_PUBLIC_BROKER_MC="XXXXXX"
NEXT_PUBLIC_BROKER_DOT="XXXXXXX"

# ── Frontend API Base URL ─────────────────────
# Absolute URL the Next.js frontend uses to reach the Express API
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Mock Service Feature Flags ────────────────
# When set to "true" these swap mock implementations for real integrations
# (no code changes required — only service/index.ts re-exports change)
USE_REAL_TMS=false
USE_REAL_COMPLIANCE=false
USE_REAL_PAYMENTS=false

# ── Stripe Connect (real integration — Phase 4 swap-in) ──────────────────
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PLATFORM_ACCOUNT_ID="acct_..."

# ── Highway / RMIS Carrier Vetting (real integration swap-in) ────────────
# HIGHWAY_API_KEY=""
# RMIS_USERNAME=""
# RMIS_PASSWORD=""

# ── Licensed Broker TMS Integration (real integration swap-in) ───────────
# TMS_API_BASE_URL=""
# TMS_API_KEY=""
