{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "moduleResolution": "node",
    "module": "CommonJS",
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "paths": {
      "@freightbridge/shared-types": ["../../packages/shared-types/src"]
    }
  },
  "include": ["src/**/*", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist"]
}
